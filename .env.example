# Copier ce fichier en .env et renseigner les valeurs. Ne jamais commiter .env.

# Base de données PostgreSQL (région européenne)
# Connexion via le pooler (port 6543), utilisée par l'application
DATABASE_URL=
# Connexion directe (port 5432), utilisée par les migrations Prisma
DIRECT_URL=

# Authentification du back-office (générer avec : npx auth secret)
AUTH_SECRET=

# Stripe (clés de test en développement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails (Resend). Sans clé, en local, les e-mails sont écrits dans .emails/.
RESEND_API_KEY=
# Sans domaine vérifié : "Zénith de Bel Air <onboarding@resend.dev>"
# (Resend n'envoie alors qu'à l'adresse du compte Resend).
EMAIL_FROM=
# Facultatif : resend | fichier | console (déduit automatiquement sinon)
EMAIL_DELIVERY=

# Stockage des fichiers (images, PDF)
STORAGE_URL=
STORAGE_KEY=

# URL publique de l'application, sans slash final (ex. http://localhost:3000)
APP_URL=http://localhost:3000

# Secret partagé pour protéger les tâches planifiées (/api/cron/*)
CRON_SECRET=

# Premier compte administrateur créé par le seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
